# Supabase — create a project at https://app.supabase.com, then copy this file
# to .env.local and fill in the values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_ and never import it from
# client components — see src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# App configuration
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Chicago
